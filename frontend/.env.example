# ─── API ─────────────────────────────────────────────────────────
# Base URL of the backend API.
# In development, Vite proxies /api/* so this isn't used directly.
# In production (Docker), this points to the backend service.
VITE_API_URL=http://localhost:5000

# ─── App ─────────────────────────────────────────────────────────
VITE_APP_NAME=Nexus Commerce
