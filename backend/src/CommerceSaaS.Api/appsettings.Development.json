{
  // appsettings.Development.json — Local development overrides
  //
  // This file is ONLY loaded when ASPNETCORE_ENVIRONMENT = "Development".
  // It MERGES with (and overrides) appsettings.json.
  //
  // NOTE: This file will eventually contain your local DB password.
  //       Add it to .gitignore before committing real credentials.
  //       For now, credentials match the docker-compose.yml defaults.

  "Logging": {
    "LogLevel": {
      // In development, we want to see everything
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      // Uncomment this to see the exact SQL queries EF Core generates:
      // "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },

  "ConnectionStrings": {
    // Local PostgreSQL via Docker Compose (see docker-compose.yml)
    // Port 5433 on the host maps to 5432 inside the postgres container
    "DefaultConnection": "Host=localhost;Port=5433;Database=saas_commerce;Username=postgres;Password=password"
  }
}
