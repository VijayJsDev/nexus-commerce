{
  // appsettings.json — Shared configuration (committed to Git, no secrets here)
  //
  // This is the base configuration file. It applies to ALL environments unless
  // overridden by appsettings.{Environment}.json (e.g., appsettings.Development.json).
  //
  // The ASPNETCORE_ENVIRONMENT variable controls which environment is active.
  // Common values: "Development", "Staging", "Production"
  "Logging": {
    "LogLevel": {
      // Default log level for all categories
      "Default": "Warning",
      // Microsoft.AspNetCore-specific logs (routing, middleware, etc.)
      "Microsoft.AspNetCore": "Warning",
      // EF Core database commands — set to "Information" to see generated SQL
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  // CORS — Which frontend origins are allowed to call this API
  // In production, replace "*" with your actual frontend URL
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:3001"
    ]
  },
  // Resend Email Service Configuration
  // Provide your API key in environment variables (Resend__ApiKey) or here.
  // When ApiKey is blank, the service automatically logs emails to console as a dev fallback.
  "Resend": {
    "ApiKey": "",
    "SuperAdminEmail": "kv077145@gmail.com",
    "FromEmail": "onboarding@resend.dev"
  },
  // Database connection string
  // In development, this is overridden by appsettings.Development.json
  // In production, this should come from an environment variable:
  //   ConnectionStrings__DefaultConnection=...
  "ConnectionStrings": {
    "DefaultConnection": ""
  }
}